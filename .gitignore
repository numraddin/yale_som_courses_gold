# Secrets — ship .env.example only
.env
.env.*
!.env.example
# Not a secret: build-time config for the production bundle (no keys, and Vite
# inlines VITE_* into the public JS anyway).
!frontend/.env.production

# Python
.venv/
__pycache__/
*.py[cod]

# Node
node_modules/
dist/

# output/audit_trail.json is tracked on purpose — it is part of the project's
# audit trail. Only the write sidecars are ignored.
output/audit_trail.tmp
output/audit_trail.corrupt.json

.DS_Store

# Source archive, not part of the project
*.zip
